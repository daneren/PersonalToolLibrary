# Install docker
yum install epel-release -y
## docker-ce repo
sudo tee /etc/yum.repos.d/docker-ce.repo <<-'EOF'
[docker-ce-stable]
name=Docker CE Stable - $basearch
baseurl=https://mirrors.aliyun.com/docker-ce/linux/centos/7/$basearch/stable
enabled=1
gpgcheck=1
gpgkey=https://mirrors.aliyun.com/docker-ce/linux/centos/gpg
EOF
yum install docker-ce -y
systemctl start docker
docker info

# Install NVIDIA470.82.01 for V100
if lspci | grep -i nvidia; then
    echo "ture" 
else
    echo "Install NVIDIA470.82.01 for V100"
    # Install NVIDIA470.82.01 for V100
    wget https://us.download.nvidia.cn/tesla/470.82.01/NVIDIA-Linux-x86_64-470.82.01.run
    sudo chmod a+x NVIDIA-Linux-x86_64-470.82.01.run
    sudo ./NVIDIA-Linux-x86_64-470.82.01.run
    nvidia-smi -pm 1
fi

